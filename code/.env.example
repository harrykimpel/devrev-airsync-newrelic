# Your DevRev organization slug (the part after app.devrev.ai/ in your DevRev URL)
DEV_ORG=my-org

# Your email address
USER_EMAIL=my@email.com

# DevRev environment. The public CLI targets production.
# Other environments require a CLI that advertises an environment flag.
ENV=prod

# Optional for Codespaces/CI: supply a DevRev PAT for the target org.
# Prefer a Codespaces secret named DEVREV_TOKEN. An existing CLI profile also works.
# DEVREV_TOKEN=

# New Relic user API key for local fixture runs (never an ingest/license key).
NEW_RELIC_API_KEY=replace-with-your-user-api-key
